{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd subtrack-backend && npm install && npm run build",
    "outputDir": "subtrack-backend/dist"
  },
  "deploy": {
    "numReplicas": 1,
    "command": "cd subtrack-backend && npm start"
  }
}
